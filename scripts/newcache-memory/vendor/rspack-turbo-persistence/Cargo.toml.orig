readme = "README.md"
repository = "https://github.com/vercel/next.js"
homepage = "https://github.com/vercel/next.js/tree/f3edea1b06730ce507aeb1b10c8e4f652ca5540d/turbopack/crates/turbo-persistence"
keywords = ["cache", "database", "persistence", "rspack"]
categories = ["caching", "database-implementations"]
include = ["src/**/*", "Cargo.toml", "README.md", "LICENSE"]

[package.metadata.rspack-turbo-persistence]
upstream-revision = "f3edea1b06730ce507aeb1b10c8e4f652ca5540d"
upstream-version = "0.1.0"

[lib]
name = "turbo_persistence"

[features]
default = []
print_stats = ["stats"]
stats = ["quick_cache/stats"]
strict_checks = []
verbose_log = []
verify_sst_content = []

[dependencies]
anyhow        = "1.0.100"
bitfield      = "0.19.4"
byteorder     = "1.5.0"
crc32fast     = "1.5.0"
dashmap       = "6.1.0"
either        = "1.15.0"
fs-err        = "3.1.1"
