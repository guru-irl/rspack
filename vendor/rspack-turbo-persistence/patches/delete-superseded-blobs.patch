diff --git a/src/tests.rs b/src/tests.rs
index 81dd762..61966f8 100644
--- a/src/tests.rs
+++ b/src/tests.rs
@@ -1979,6 +1979,52 @@ fn count_blob_files(dir: &Path) -> usize {
         .count()
 }
 
+#[test]
+fn commit_deletes_superseded_blob() -> Result<()> {
+    let tempdir = tempfile::tempdir()?;
+    let path = tempdir.path();
+    let key = vec![1u8];
+    let replacement = vec![43u8; MAX_MEDIUM_VALUE_SIZE + 1];
+
+    {
+        let db = TurboPersistence::<_, 1>::open_with_parallel_scheduler(
+            path.to_path_buf(),
+            RayonParallelScheduler,
+        )?;
+
+        // A medium predecessor must not be mistaken for a blob.
+        let batch = db.write_batch()?;
+        batch.put(0, key.clone(), vec![41u8; MAX_MEDIUM_VALUE_SIZE - 1].into())?;
+        db.commit_write_batch(batch)?;
+        assert_eq!(count_blob_files(path), 0);
+
+        let batch = db.write_batch()?;
+        batch.put(0, key.clone(), vec![42u8; MAX_MEDIUM_VALUE_SIZE + 1].into())?;
+        db.commit_write_batch(batch)?;
+        assert_eq!(count_blob_files(path), 1);
+        assert_eq!(
+            db.get(0, &key)?.as_deref(),
+            Some(&vec![42u8; MAX_MEDIUM_VALUE_SIZE + 1][..])
+        );
+
+        let batch = db.write_batch()?;
+        batch.put(0, key.clone(), replacement.clone().into())?;
+        db.commit_write_batch(batch)?;
+        assert_eq!(count_blob_files(path), 1, "Commit must retire the old blob");
+        assert_eq!(db.get(0, &key)?.as_deref(), Some(&replacement[..]));
+        db.shutdown()?;
+    }
+
+    let db = TurboPersistence::<_, 1>::open_with_parallel_scheduler(
+        path.to_path_buf(),
+        RayonParallelScheduler,
+    )?;
+    assert_eq!(count_blob_files(path), 1);
+    assert_eq!(db.get(0, &key)?.as_deref(), Some(&replacement[..]));
+    db.shutdown()?;
+    Ok(())
+}
+
